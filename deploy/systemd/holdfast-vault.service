[Unit]
Description=Holdfast vault (off-site copies of another site's hosts)
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=exec
ExecStart=/usr/bin/holdfast-vault -config /etc/holdfast-vault/vault.yaml
# The API socket in /run/holdfast-vault is root-only; holdfast --vault on this host talks to it.
RuntimeDirectory=holdfast-vault
RuntimeDirectoryMode=0700
StateDirectory=holdfast-vault
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/holdfast-vault /run/holdfast-vault
PrivateTmp=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
