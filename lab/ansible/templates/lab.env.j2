# The Holdfast lab {{ lab }}'s settings, written by lab/ansible/render.yml on every lab/lab up: do not edit. Source it
# in a shell (set -a; . lab.env; set +a) to reach the lab. Credentials are not in it, only the files that hold them
# (0600, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY lines, the format storage.ReadKeyFile reads).
HF_LAB={{ lab | quote }}
HF_DOMAIN={{ lab_domain | quote }}
HF_STATE={{ lab_state | quote }}
HF_SSH_KEY={{ lab_key | quote }}
HF_INVENTORY={{ (lab_state ~ '/inventory.yml') | quote }}
HF_VMS=({{ vms.keys() | join(' ') }})
HF_STORAGE_VM={{ lab_storage_vm }}
HF_SERVER_VM={{ lab_server_vm }}
HF_AGENTS=({{ lab_agent_vms | join(' ') }})
{% for vm, v in vms.items() %}
HF_VM_IP_{{ vm }}={{ v.addresses[0] }}
{% endfor %}
# RGW, site A's S3: by name from the VMs, by address from this host as well.
HF_RGW_URL={{ lab_rgw_url | quote }}
HF_RGW_URL_HOST={{ lab_rgw_url_host | quote }}
HF_BUCKET={{ storage.bucket | quote }}
HF_REGION={{ storage.region | quote }}
HF_REPO_BASE={{ ('s3:' ~ lab_rgw_url ~ '/' ~ storage.bucket ~ '/repos') | quote }}
{% for user in storage.users %}
HF_RGW_CREDENTIALS_{{ user | regex_replace('^holdfast-', '') | regex_replace('-', '_') | upper }}={{ (lab_creds ~ '/' ~ user ~ '.env') | quote }}
{% endfor %}
HF_CEPH_VERSION_FILE={{ (lab_state ~ '/ceph-version') | quote }}
# PostgreSQL on {{ lab_server_vm }}: database {{ postgresql.database }}, user {{ postgresql.user }}.
HF_PG_HOST={{ (lab_server_vm ~ '.' ~ lab_domain) | quote }}
HF_PG_DATABASE={{ postgresql.database | quote }}
HF_PG_USER={{ postgresql.user | quote }}
HF_PG_PASSWORD_FILE={{ (lab_creds ~ '/postgresql-' ~ postgresql.user ~ '.pw') | quote }}
HF_PG_DSN_FILE={{ (lab_creds ~ '/postgresql-' ~ postgresql.user ~ '.dsn') | quote }}
HF_RESTIC=/usr/libexec/holdfast/restic
HF_RESTIC_VERSION={{ restic.version | quote }}
