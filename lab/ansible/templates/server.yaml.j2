# /etc/holdfast/server.yaml on {{ inventory_hostname }}, the lab {{ lab }}'s Holdfast server: written by lab/ansible/site.yml
# (do not edit here; a change is made there and lab/lab up applies it). No secret is in this file, only the files that
# hold them, each root-only. deploy/examples/server.yaml explains every setting.
listen: ":8443"
public_url: https://{{ lab_server_fqdn }}:8443
tls:
  cert_file: /etc/holdfast/tls/server.crt   # the server's certificate, then the lab CA's (lab_state/ca/)
  key_file: /etc/holdfast/tls/server.key
ca_sha256: "{{ hf_ca_sha256 }}"   # the lab CA's certificate (DER), which agents pin
api_socket: /run/holdfast/api.sock

database_dsn_file: /etc/holdfast/db.dsn
credentials_key_file: /etc/holdfast/credentials.key   # holdfast-server keygen, once
state_dir: /var/lib/holdfast-server
restic_bin: /usr/libexec/holdfast/restic
default_zone: UTC

storage:
  endpoint: {{ lab_rgw_url }}
  bucket: {{ storage.bucket }}
  region: {{ storage.region }}
  # Decision 041: two keys for the bucket, and none on any host (lab/rgw-documented-layout.sh gives them their
  # statements in the bucket policy).
  maintenance_credentials_file: /etc/holdfast/maintenance.env   # holdfast-maint's key
  gateway_credentials_file: /etc/holdfast/gateway.env           # holdfast-gateway's key

# Off-site copies (spec §3.7): the lab has one RGW, so the off-site bucket is a second bucket on it, holdfast-offsite
# (lab/rgw-offsite-layout.sh), with holdfast-offsite's key.
offsite:
  endpoint: {{ lab_rgw_url }}
  bucket: holdfast-offsite
  region: {{ storage.region }}
  maintenance_credentials_file: /etc/holdfast/offsite.env
  poll: 30s

maintenance:
  check: daily
  check_cycle_days: 30
  retention: daily

# Decision 036: each host's repository password, encrypted to the lab's offline key (credentials/escrow-age.key on the
# lab host), in escrow/<fqdn>.age. holdfast-maint may write escrow/ (lab/rgw-documented-layout.sh, B012).
escrow:
  age_recipient: {{ hostvars['localhost'].lab_escrow_recipient }}

# The UI and /api/v1 for people, with login (decision 034). The lab has no CA browsers trust, so the UI has the agent
# listener's certificate from the lab's CA.
ui:
  listen: ":{{ ui.port }}"
  public_url: {{ lab_ui_url }}
  tls:
    cert_file: /etc/holdfast/tls/server.crt
    key_file: /etc/holdfast/tls/server.key

# Authelia on this VM, Holdfast registered there as the client holdfast (lab/ansible/templates/authelia.yml.j2).
auth:
  oidc:
    issuer: {{ lab_oidc_issuer }}
    client_id: holdfast
    client_secret_file: /etc/holdfast/oidc-client-secret   # the lab's credentials/authelia-client.secret
    ca_file: /etc/holdfast/tls/ca.crt                     # the lab's CA, which signed Authelia's certificate
    groups_claim: groups
  bootstrap_admins: []
