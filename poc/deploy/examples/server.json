{
  "listen": "127.0.0.1:8480",
  "state_dir": "/var/lib/holdfast-server",
  "repo_base": "/srv/holdfast/repos",
  "admin_token": "CHANGE-ME",
  "maintenance_every": "24h",
  "check_cycle_days": 30,
  "hosts": [
    {
      "name": "web01",
      "enroll_code": "one-time-code-web01",
      "jobs": [
        {
          "id": "system",
          "paths": ["/etc", "/var/www", "/home"],
          "excludes": ["/home/*/.cache"],
          "interval": "24h",
          "retry": "1h",
          "retention": {"keep_daily": 14, "keep_weekly": 8, "keep_monthly": 12, "keep_yearly": 3},
          "extra_args": ["--one-file-system", "--exclude-caches"]
        }
      ]
    }
  ]
}
