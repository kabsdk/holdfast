[Unit]
Description=Holdfast backup agent
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/holdfast-agent -config /etc/holdfast/agent.json
# Runs as root: reading every file and restoring ownership, ACLs and SELinux labels needs it.
StateDirectory=holdfast-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true
Restart=always
RestartSec=10
# SIGTERM leaves the run marker; the next start reports the run as "interrupted".
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
